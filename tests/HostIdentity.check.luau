-- Studio server command bar; SURV-03 and SURV-10.
local HostIdentity = require(game.ServerScriptService.FNABKServer.HostIdentity)
assert(HostIdentity.resolve(123, false, 0) == 123)
assert(HostIdentity.resolve(0, true, -1) == -1)
assert(HostIdentity.resolve(123, true, -1) == 123)
assert(HostIdentity.resolve(0, false, 123) == nil)
assert(HostIdentity.resolve(-2, false, 123) == nil)
assert(HostIdentity.resolve(0, false, 123, 456) == 456)
assert(HostIdentity.resolve(123, false, 0, 456) == 123)
assert(HostIdentity.resolve(0, false, 123, -1) == nil)
assert(HostIdentity.resolve(0, false, 123, 0/0) == nil)
assert(HostIdentity.canClaimSolo(1, 123, 123))
assert(not HostIdentity.canClaimSolo(1, 123, 456))
assert(not HostIdentity.canClaimSolo(1, 0, 456))
assert(not HostIdentity.canClaimSolo(2, 123, 123))
assert(HostIdentity.canAdmit(2, 4, 2, 99, false))
assert(not HostIdentity.canAdmit(3, 4, 2, 99, false))
assert(HostIdentity.canAdmit(3, 4, 99, 99, false))
assert(HostIdentity.canAdmit(3, 4, 2, 99, true))
assert(not HostIdentity.canAdmit(4, 4, 99, 99, false))
assert(HostIdentity.canAdmit(3, 4, 2, 0, false))
print("Host identity checks passed")
