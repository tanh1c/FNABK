-- Controlled Studio Play server: party eligibility at wave start (SURV-02).
local wave = require(game.ServerScriptService.FNABKServer.WaveService)
local player = assert(game.Players:GetPlayers()[1])
local character = assert(player.Character)
local humanoid = assert(character:FindFirstChildOfClass("Humanoid"))
assert(wave.eligible(player))
character:SetAttribute("FNABKEliminated", true)
assert(not wave.eligible(player))
character:SetAttribute("FNABKEliminated", false)
player:SetAttribute("FNABKDowned", true)
assert(wave.eligible(player))
player:SetAttribute("FNABKEliminated", true)
assert(not wave.eligible(player))
player:SetAttribute("FNABKEliminated", false)
player:SetAttribute("FNABKDowned", false)
character:SetAttribute("FNABKDowned", true)
assert(wave.eligible(player))
character:SetAttribute("FNABKDowned", false)
assert(humanoid.Health > 0 and wave.eligible(player))
return "Wave eligibility checks passed"
