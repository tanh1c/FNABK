-- Studio Play server: isolated daily shared Trust awards (SURV-13).
local help = require(game.ServerScriptService.FNABKServer.SurvivorHelp)
local student = Instance.new("Model")
student:SetAttribute("NPCType", "Student")
local trust = Instance.new("IntValue")
local inventory = require(game.ServerScriptService.FNABKServer.Inventory)
local items = inventory.new()
trust.Value = 50
assert(not help.deliverFood(student, trust, items) and trust.Value == 50)
assert(inventory.add(items, {id = "food1", kind = "Food"}))
assert(help.deliverFood(student, trust, items) and trust.Value == 60 and inventory.count(items, "Food") == 0)
assert(inventory.add(items, {id = "food2", kind = "Food"}))
assert(not help.deliverFood(student, trust, items) and trust.Value == 60 and inventory.count(items, "Food") == 1)
trust.Value = 85
assert(help.award(student, trust, 1) and trust.Value == 95)
assert(not help.award(student, trust, 1) and trust.Value == 95)
assert(help.award(student, trust, 2) and trust.Value == 100)
assert(inventory.add(items, {id = "scrap1", kind = "Scrap"}))
assert(not help.repair(student, trust, 2, items) and inventory.count(items, "Scrap") == 1)
trust.Value = 50
assert(help.repair(student, trust, 3, items) and trust.Value == 60 and inventory.count(items, "Scrap") == 0)
assert(not help.award(student, trust, 3) and not help.repair(student, trust, 4, items))
assert(inventory.add(items, {id = "water1", kind = "Water"}))
assert(not help.deliverWater(student, trust, 3, items) and inventory.count(items, "Water") == 1)
assert(help.deliverWater(student, trust, 4, items) and trust.Value == 70 and inventory.count(items, "Water") == 0)
assert(not help.award(student, trust, 4) and not help.deliverWater(student, trust, 5, items))
student:SetAttribute("StudentState", "Incapacitated")
assert(not help.award(student, trust, 5))
student:Destroy()
trust:Destroy()
print("Survivor help checks passed")
