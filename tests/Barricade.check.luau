local Inventory = require(game.ServerScriptService.FNABKServer.Inventory)
local Barricade = require(game.ServerScriptService.FNABKServer.Barricade)
local items, state = Inventory.new(), Barricade.new()
for i = 1, 5 do assert(Inventory.add(items, { id = "scrap" .. i, kind = "Scrap" })) end
assert(not Barricade.install(state, items) and Inventory.count(items, "Scrap") == 5)
assert(Inventory.add(items, { id = "cloth", kind = "Cloth" }))
assert(Barricade.install(state, items) and state.health == 100)
assert(not Barricade.install(state, items) and not Barricade.repair(state, items))
assert(not Barricade.damage(state, 0/0) and Barricade.damage(state, 120) and state.health == 0)
assert(Barricade.repair(state, items) and state.health == 50 and Inventory.count(items, "Scrap") == 0)
assert(not Barricade.repair(state, items) and state.health == 50)
local copy = assert(Barricade.restore({ installed = true, health = 0 }))
assert(copy.installed and copy.health == 0)
assert(not Barricade.restore({ installed = false, health = 5 }))
assert(not Barricade.restore({ installed = true, health = 0/0 }))
assert(not Barricade.restore({ installed = true, health = 101 }))
print("Barricade checks passed")
