-- Studio server command bar, after Rojo sync. SURV-08.
local Gun = require(game.ServerScriptService.FNABKServer.Firearm)
local pistol = Gun.new("Pistol")
local box = { id = "p", kind = "PistolAmmo", rounds = 20 }
assert(Gun.startReload(pistol, box, 0))
assert(not Gun.finishReload(pistol, box, 1.9))
assert(Gun.finishReload(pistol, box, 2) and pistol.loaded == 12 and box.rounds == 8)
assert(Gun.fire(pistol, 3) and pistol.loaded == 11)
assert(not Gun.fire(pistol, 3.1) and pistol.loaded == 11)
local rifle = Gun.new("Rifle")
assert(not Gun.startReload(rifle, box, 0))
local rifleBox = { id = "r", kind = "RifleAmmo", rounds = 30 }
assert(Gun.startReload(rifle, rifleBox, 0))
assert(not Gun.finishReload(rifle, { id = "forged", kind = "RifleAmmo", rounds = 30 }, 3))
assert(Gun.finishReload(rifle, rifleBox, 2.8) and rifle.loaded == 30 and rifleBox.rounds == 0)
assert(not Gun.fire(rifle, 0/0) and rifle.loaded == 30)
local shell = { id = "s", kind = "ShotgunAmmo", rounds = 10 }
local shotgun = Gun.new("Shotgun")
assert(Gun.startReload(shotgun, shell, 0))
assert(Gun.finishReload(shotgun, shell, 0.7) and shotgun.loaded == 1 and shell.rounds == 9)
assert(Gun.fire(shotgun, 0.8) and shotgun.loaded == 0 and shotgun.reloadAt == nil)
assert(not Gun.finishReload(shotgun, shell, 2) and shell.rounds == 9)
assert(not Gun.startReload(shotgun, { id = "bad", kind = "ShotgunAmmo", rounds = 11 }, 3))
local late = Gun.new("Shotgun")
local lateBox = { id = "late", kind = "ShotgunAmmo", rounds = 10 }
assert(Gun.startReload(late, lateBox, 0))
assert(Gun.finishReload(late, lateBox, 2.1) and late.loaded == 3 and lateBox.rounds == 7)
Gun.cancelReload(late)
assert(not Gun.finishReload(late, lateBox, 10) and lateBox.rounds == 7)
assert(Gun.shotgunPelletDamage(15) == 10 and Gun.shotgunPelletDamage(40) == 5 and Gun.shotgunPelletDamage(65) == 0)
local saved = assert(Gun.snapshot(pistol, 3.2))
local resumed = assert(Gun.restore(saved, 100))
assert(resumed.loaded == 11 and not Gun.fire(resumed, 100.1) and Gun.fire(resumed, 100.21))
assert(Gun.startReload(shotgun, shell, 4))
local held = assert(Gun.restore(assert(Gun.snapshot(shotgun, 4.1)), 100))
assert(held.reloadAt == nil and held.reloadBox == nil and held.loaded == shotgun.loaded and shell.rounds == 9)
assert(not Gun.restore({ kind = "Pistol", loaded = 13, cooldown = 0 }, 0))
assert(not Gun.restore({ kind = "Pistol", loaded = 1, cooldown = 0/0 }, 0))
assert(not Gun.restore({ kind = "Pistol", loaded = 1, cooldown = 10 }, 0))
assert(not Gun.restore({ kind = "Unknown", loaded = 1, cooldown = 0 }, 0))
print("Firearm checks passed")
