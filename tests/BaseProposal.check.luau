-- Studio server command bar. SURV-03/04.
local Proposal = require(game.ServerScriptService.FNABKServer.BaseProposal)
local state = Proposal.new()
local id = Proposal.begin(state, "B4", 10, 42)
assert(id and not Proposal.confirm(state, id, 11, 52))
assert(not Proposal.confirm(state, id, 10, 51.99))
assert(not Proposal.confirm(state, id + 1, 10, 52))
assert(Proposal.confirm(state, id, 10, 52) == "B4")
assert(not Proposal.confirm(state, id, 10, 53))
local nextId = Proposal.begin(state, "A2", 10, 60)
assert(nextId and nextId ~= id)
Proposal.cancel(state)
assert(not Proposal.confirm(state, nextId, 10, 70))
assert(not Proposal.begin(state, "", 10, 80))
print("Base proposal checks passed")
