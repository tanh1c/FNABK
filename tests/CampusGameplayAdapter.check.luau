-- Run in Studio's server command bar with the campus v6 present in Workspace.
local server = game:GetService("ServerScriptService"):WaitForChild("FNABKServer")
local graybox = require(server:WaitForChild("GrayboxMap"))
local adapter = require(server:WaitForChild("CampusGameplayAdapter"))
local campus = assert(workspace:FindFirstChild("FNABK_Campus_PixelBuildings_PhaseC_v6"))
local temporary = Instance.new("Folder")
temporary.Parent = game:GetService("ServerStorage")
local ok, result = pcall(function()
	local map = graybox.Build(temporary, 100)
	adapter.Place(map, campus)
	assert(not map:FindFirstChild("CourtyardFloor"), "Old graybox floor remains")
	assert(map.PlayerSpawn.Position.X > 4000, "Spawn was not moved to v6")
	assert(map.A3.FuseCrate:GetAttribute("FNABKResetPosition") == map.A3.FuseCrate.Position, "Crate reset position is stale")
	assert(map.A3.PressurePlate.Position.X > 4000 and map.B4.Generator.Position.X > 4000, "Mission anchors are not on v6")
	assert(map.Library.Suspects.LibraryMimic.PrimaryPart.Position.X > 4000, "Library suspects are not on v6")
	assert(map.Gate1.ControlPanel.Position.X > 4000 and map.Gate1.ExitZone.Position.X > 4000, "Gate anchors are not on v6")
	assert(typeof(map:GetAttribute("FNABKMedkitA3")) == "Vector3", "Medkit position is missing")
end)
temporary:Destroy()
assert(ok, result)
print("Campus v6 gameplay anchor checks passed")
