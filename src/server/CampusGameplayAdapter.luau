--!strict
-- Place the existing prototype objectives in the selected campus (SURV-06/08).
local CampusGameplayAdapter = {}

local function child(parent: Instance, name: string): Instance
	return assert(parent:FindFirstChild(name), parent:GetFullName() .. " is missing " .. name)
end

local function part(parent: Instance, name: string): BasePart
	local instance = child(parent, name)
	assert(instance:IsA("BasePart"), instance:GetFullName() .. " must be a BasePart")
	return instance
end

local function center(parent: Instance, name: string): Vector3
	local model = child(parent, name)
	assert(model:IsA("Model"), name .. " must be a Model")
	local cf = model:GetBoundingBox()
	return cf.Position
end

function CampusGameplayAdapter.Place(map: Folder, campus: Model)
	local buildings = child(campus, "Buildings")
	local a3Center, a2Center, b4Center = center(buildings, "A3"), center(buildings, "A2"), center(buildings, "B4")
	local boundary = child(child(campus, "CampusBoundaryAndGates_v1"), "BoundaryEdge_1")
	local gateModel = child(boundary, "CampusGate_1")
	local pillars = {}
	for _, item in ipairs(gateModel:GetChildren()) do
		if item.Name == "GatePillar" and item:IsA("BasePart") then table.insert(pillars, item) end
	end
	assert(#pillars == 2, "Campus Gate 1 requires two pillars")
	table.sort(pillars, function(a, b) return a.Position.Z < b.Position.Z end)
	local middle = (pillars[1].Position + pillars[2].Position) / 2
	local along = Vector3.new(pillars[2].Position.X - pillars[1].Position.X, 0, pillars[2].Position.Z - pillars[1].Position.Z).Unit
	local outward = Vector3.new(along.Z, 0, -along.X)
	local gateFrame = CFrame.fromMatrix(Vector3.new(middle.X, 0, middle.Z), outward, Vector3.yAxis, along)

	-- Remove only primitive geometry generated by GrayboxMap in this run.
	for _, item in ipairs(map:GetChildren()) do
		if item:IsA("BasePart") and item.Name ~= "PlayerSpawn" then item:Destroy() end
	end
	local spawn = part(map, "PlayerSpawn")
	spawn.CFrame = gateFrame * CFrame.new(-25, 0.1, 0)

	local a3 = child(map, "A3")
	local crate = part(a3, "FuseCrate")
	local plate = part(a3, "PressurePlate")
	crate.CFrame = CFrame.new(a3Center.X - 30, 2.8, a3Center.Z - 20)
	crate:SetAttribute("FNABKResetPosition", crate.Position)
	plate.CFrame = CFrame.new(a3Center.X - 30, 0.82, a3Center.Z - 10)
	map:SetAttribute("CrateResetBoundsMin", Vector3.new(a3Center.X - 100, -10, a3Center.Z - 100))
	map:SetAttribute("CrateResetBoundsMax", Vector3.new(a3Center.X + 100, 40, a3Center.Z + 100))

	local suspects = child(child(map, "Library"), "Suspects")
	for i, name in ipairs({"LibraryStudentA", "LibraryMimic", "LibraryStudentB"}) do
		local model = child(suspects, name)
		assert(model:IsA("Model"), name .. " must be a Model")
		model:PivotTo(CFrame.new(a2Center.X + (i - 2) * 20, 3.3, a2Center.Z - 10))
	end
	local b4 = child(map, "B4")
	part(b4, "SpareFuse").Position = Vector3.new(b4Center.X - 10, 1.15, b4Center.Z - 10)
	part(b4, "Generator").Position = Vector3.new(b4Center.X + 10, 3.3, b4Center.Z - 10)
	part(b4, "GeneratorIndicator").Position = Vector3.new(b4Center.X + 10, 4.9, b4Center.Z - 11.58)
	map:SetAttribute("FNABKMedkitA3", Vector3.new(a3Center.X - 20, 1.4, a3Center.Z + 10))
	map:SetAttribute("FNABKMedkitB4", Vector3.new(b4Center.X - 20, 1.4, b4Center.Z + 10))

	local gate = child(map, "Gate1")
	for _, name in ipairs({"LeftPost", "RightPost", "TopBeam", "ExitWalkway"}) do child(gate, name):Destroy() end
	local door = part(gate, "GateDoor")
	door.Size = Vector3.new(1, 10, (pillars[2].Position - pillars[1].Position).Magnitude - 2)
	door.CFrame = gateFrame * CFrame.new(0, 5, 0)
	part(gate, "ControlPanel").CFrame = gateFrame * CFrame.new(-4, 2, -10)
	part(gate, "ExitZone").CFrame = gateFrame * CFrame.new(9, 3, 0)

	local mimic = child(map, "Mimic")
	local student = child(map, "Student")
	assert(mimic:IsA("Model") and student:IsA("Model"), "Missing prototype NPCs")
	mimic:PivotTo(gateFrame * CFrame.new(-48, 2.5, 12))
	student:PivotTo(CFrame.new(a2Center.X, 3.3, a2Center.Z + 10))
end

return table.freeze(CampusGameplayAdapter)
